{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "functions": {
      "src/app/api/chat/route.ts": { "maxDuration": 30 },
      "src/app/api/health/route.ts": { "maxDuration": 10 }
    },
    "headers": [
      {
        "source": "/api/(.*)",
        "headers": [{ "key": "Cache-Control", "value": "no-store" }]
      }
    ]
}  